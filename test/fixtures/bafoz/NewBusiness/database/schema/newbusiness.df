ADD TABLE "ContractBenefit"
  AREA "Schema Area"
  LABEL "Contract Benefit"
  DUMP-NAME "contractbenefit"

ADD FIELD "ContractId" OF "ContractBenefit" AS character
  FORMAT "x(12)"
  LABEL "Contract Id"
  POSITION 2
  MAX-WIDTH 24
  ORDER 10
  MANDATORY

ADD FIELD "BenefitId" OF "ContractBenefit" AS character
  FORMAT "x(12)"
  LABEL "Benefit Id"
  POSITION 3
  MAX-WIDTH 24
  ORDER 20
  MANDATORY

ADD FIELD "BenefitCode" OF "ContractBenefit" AS character
  FORMAT "x(30)"
  LABEL "Benefit Code"
  POSITION 4
  MAX-WIDTH 60
  ORDER 30

ADD FIELD "Premium" OF "ContractBenefit" AS decimal
  FORMAT "->>,>>9.99"
  INITIAL "0"
  LABEL "Premium"
  POSITION 5
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 40

ADD FIELD "EffectiveDate" OF "ContractBenefit" AS date
  FORMAT "99/99/9999"
  LABEL "Effective Date"
  POSITION 6
  MAX-WIDTH 4
  ORDER 50

ADD INDEX "ContractBenefit" ON "ContractBenefit"
  AREA "Schema Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "ContractId" ASCENDING
  INDEX-FIELD "BenefitId" ASCENDING


ADD TABLE "CollectionInstruction"
  AREA "Schema Area"
  LABEL "Collection Instruction"
  DUMP-NAME "collectioninstruction"

ADD FIELD "ContractId" OF "CollectionInstruction" AS character
  FORMAT "x(12)"
  LABEL "Contract Id"
  POSITION 2
  MAX-WIDTH 24
  ORDER 10
  MANDATORY

ADD FIELD "CollectionMethod" OF "CollectionInstruction" AS character
  FORMAT "x(20)"
  LABEL "Collection Method"
  POSITION 3
  MAX-WIDTH 40
  ORDER 20

ADD FIELD "CollectionDay" OF "CollectionInstruction" AS integer
  FORMAT ">9"
  LABEL "Collection Day"
  POSITION 4
  MAX-WIDTH 4
  ORDER 30

ADD FIELD "AccountNumber" OF "CollectionInstruction" AS character
  FORMAT "x(30)"
  LABEL "Account Number"
  POSITION 5
  MAX-WIDTH 60
  ORDER 40

ADD FIELD "BankCode" OF "CollectionInstruction" AS character
  FORMAT "x(10)"
  LABEL "Bank Code"
  POSITION 6
  MAX-WIDTH 20
  ORDER 50

ADD FIELD "AccountHolderName" OF "CollectionInstruction" AS character
  FORMAT "x(60)"
  LABEL "Account Holder Name"
  POSITION 7
  MAX-WIDTH 120
  ORDER 60

ADD INDEX "ContractId" ON "CollectionInstruction"
  AREA "Schema Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "ContractId" ASCENDING


ADD TABLE "ContractAudit"
  AREA "Schema Area"
  LABEL "Contract Audit"
  DUMP-NAME "contractaudit"

ADD FIELD "AuditId" OF "ContractAudit" AS character
  FORMAT "x(12)"
  LABEL "Audit Id"
  POSITION 2
  MAX-WIDTH 24
  ORDER 10
  MANDATORY

ADD FIELD "ContractId" OF "ContractAudit" AS character
  FORMAT "x(12)"
  LABEL "Contract Id"
  POSITION 3
  MAX-WIDTH 24
  ORDER 20
  MANDATORY

ADD FIELD "Action" OF "ContractAudit" AS character
  FORMAT "x(30)"
  LABEL "Action"
  POSITION 4
  MAX-WIDTH 60
  ORDER 30

ADD FIELD "OldValue" OF "ContractAudit" AS character
  FORMAT "x(60)"
  LABEL "Old Value"
  POSITION 5
  MAX-WIDTH 120
  ORDER 40

ADD FIELD "NewValue" OF "ContractAudit" AS character
  FORMAT "x(60)"
  LABEL "New Value"
  POSITION 6
  MAX-WIDTH 120
  ORDER 50

ADD FIELD "UserId" OF "ContractAudit" AS character
  FORMAT "x(20)"
  LABEL "User Id"
  POSITION 7
  MAX-WIDTH 40
  ORDER 60

ADD FIELD "Timestamp" OF "ContractAudit" AS datetime
  FORMAT "99/99/9999 HH:MM:SS.SSS"
  LABEL "Timestamp"

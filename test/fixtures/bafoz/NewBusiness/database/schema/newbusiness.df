  MAX-WIDTH 16
  ORDER 70

ADD INDEX "AuditId" ON "ContractAudit"
  AREA "Schema Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "AuditId" ASCENDING

ADD INDEX "ContractId" ON "ContractAudit"
  AREA "Schema Area"
  INDEX-FIELD "ContractId" ASCENDING

/* database/delta/002_benefit_cover_amount.df
   Incremental schema change: adds CoverAmount (default sum assured) to
   the Benefit catalogue table. Load on top of the baseline schema:

       proutil newbusiness -C LOAD-DF database/delta/002_benefit_cover_amount.df
*/

ADD FIELD "CoverAmount" OF "Benefit" AS decimal
  FORMAT "->>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Cover Amount"
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 70

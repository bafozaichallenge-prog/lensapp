# One image for both Render services (web and worker); each service picks its command in render.yaml.
# Not built in the authoring environment (no Docker daemon): the first Render build is the first real build.
FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages ./packages
RUN npm ci
COPY . .
# Prisma validates that env("DATABASE_URL") exists even when only generating the client, so give it a build-only value
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build npx prisma generate --schema packages/storage/prisma/schema.prisma
# Build-time placeholders live on this one command only (nothing connects while building). They are NOT baked into the
# image, so a service that is missing DATABASE_URL fails with "Environment variable not found" instead of trying localhost.
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build AUTH_SECRET=build-time-placeholder npm run build && node scripts/bundle-worker.mjs \
 && cp -r apps/web/.next/static apps/web/.next/standalone/apps/web/.next/static
ENV NODE_ENV=production HOSTNAME=0.0.0.0
CMD ["node", "apps/web/.next/standalone/apps/web/server.js"]

# ── Required ───────────────────────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me
# 32 random bytes, base64. Format: keyId:base64. The first key is used to encrypt; older keys stay listed so existing
# credentials can still be decrypted (rotation). Generate:  echo "k1:$(openssl rand -base64 32)"
LENS_ENCRYPTION_KEYS=
# Session/JWT signing secret for Auth.js:  openssl rand -base64 32
AUTH_SECRET=
# The public URL users type. Use https:// in production: it turns on Secure cookies and the __Secure- prefix.
AUTH_URL=http://localhost:3000

# ── GitLab sign-in (OIDC) ────────────────────────────────────────────────────────────────────────────
# Create an OAuth application in GitLab (Admin > Applications, or a group/user application):
#   Redirect URI: <AUTH_URL>/api/auth/callback/gitlab      Scopes: openid profile email read_user read_api
GITLAB_BASE_URL=https://gitlab.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# ── Access bootstrap ──────────────────────────────────────────────────────────────────────────────────
# Comma-separated e-mail addresses that become Admin when they sign in. Nobody is Admin by default:
# the first person to sign in is a Viewer.
LENS_BOOTSTRAP_ADMINS=
# Optional local administrator, disabled unless set. Generate:  npm run break-glass:hash -- '<a long password>'
LENS_BREAK_GLASS_HASH=
# Extra origins allowed to call server actions (only needed behind unusual proxies)
LENS_ALLOWED_ORIGINS=

# ── AI (optional). Without a key Lens shows deterministic code-graph findings only. ──────────────────
ANTHROPIC_API_KEY=
LENS_MODEL=
LENS_AI_PROVIDER=anthropic
# Token ceiling per analysis (input + output). Default 400000.
LENS_TOKEN_BUDGET=

# ── Ports ─────────────────────────────────────────────────────────────────────────────────────────────
WEB_PORT=3000

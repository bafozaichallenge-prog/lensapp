{
  "name": "lens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:validate": "prisma validate --schema packages/storage/prisma/schema.prisma",
    "db:generate": "prisma generate --schema packages/storage/prisma/schema.prisma",
    "test:e2e": "npm -w @lens/web run build && vitest run test/e2e",
    "build": "npm -w @lens/web run build",
    "break-glass:hash": "vite-node scripts/hash-password.ts",
    "perf": "vite-node scripts/perf.ts",
    "seed": "vite-node scripts/seed.ts",
    "backup": "scripts/backup.sh"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "axe-core": "^4.13.0",
    "playwright-core": "^1.63.0",
    "prisma": "^6.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "zod": "^3.23.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}